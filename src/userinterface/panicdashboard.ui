  <property name="styleSheet">
   <string notr="true">/* --- Main Window Background --- */
#MainFrame {
    background-color: #232424;
    border-radius: 40px;
    border: 2px solid rgb(16, 146, 191); 
}

/*--- Attached Device Interaction ---*/
#LeftControllerButton, #RightControllerButton, #HMDButton {
	font-size: 18px;
}

/*--- Version Number ---*/
#versionNumber{
	font-size: 12px;
	font-weight: bold;
}

/* --- Top Header --- */
#TitleFrame {
    background-color: #295A6B;
    border-top-left-radius: 37px;
    border-top-right-radius: 37px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
	border-bottom: 2px solid rgb(16, 146, 191);
}

#settingsTitle {
    font-size: 40px;
    font-weight: bold;
}

/* --- The Interaction Frame --- */
#InteractionFrame {
    border-radius: 10px;
}


/* --- The Inner Grid Panels Specific Styling--- */
#ColorblindnessFrame, #showTrackersFrame, #ScaleFrame, #OpacityFrame, #DistanceFadeFrame, #ResetFrame, #AttachedDeviceFrame {
    background-color: rgb(50, 50, 50);
    border-radius: 30px;
}

#colorBlindnessTitle, #showTrackersTitle, #ScaleTitle, #OpacityTitle, #DistanceFadeTitle, #LostOrBrokeTitle, #AttachedDeviceTitle {
	font-size: 25px;
    font-weight: bold;
}

#colorBlindnessTitleFrame, #showTrackersTitleFrame, #DistanceFadeTitleFrame, #ScaleTitleFrame, #OpacityTitleFrame, #LostOrBrokeTitleFrame, #AttachedDeviceTitleFrame {
    background-color: #454545;
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

#DistanceFadeInteractionFrame, #panicButtonFrame, #DistanceFadeCheckFrame, #showTrackersCheckboxFrame {
	background-color: transparent;
	border: none;
}

/* --- Checkboxes  --- */
#distanceFadeCheck, #showTrackersCheckbox {
	font-size: 23px;
    spacing: 150px;
    color: white;
}

/* --- The Unchecked State (Empty Circle) --- */
#distanceFadeCheck::indicator, #showTrackersCheckbox::indicator {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: #232424; 
    border: 2px solid #454545; 
}

/* --- Hover State --- */
#distanceFadeCheck::indicator:hover, #showTrackersCheckbox::indicator:hover {
    border: 2px solid rgb(16, 146, 191); 
}

/* --- The Checked State (Filled Blue Circle) --- */
#distanceFadeCheck::indicator:checked, #showTrackersCheckbox::indicator:checked {
    background-color: rgb(16, 146, 191); 
    border: 2px solid #232424;
    image: none; 
}

/*--- Colorblind Options Overrides ---*/
#colorblindSelectionGroup {
	border: none;
	background: transparent;
	title: none;
}

#colorblindSelectionGroup QRadioButton {
	font-size: 23px;
    color: white;
}

#colorblindSelectionGroup QRadioButton::indicator {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: #232424; 
    border: 2px solid #454545; 
}

#colorblindSelectionGroup QRadioButton::indicator:hover {
    border: 2px solid rgb(16, 146, 191); 
}

#colorblindSelectionGroup QRadioButton::indicator:checked {
    background-color: rgb(16, 146, 191); 
    border: 2px solid #232424;
    image: none; 
}


/*--- Global QLabel --- */
QLabel {
	font-size: 23px;
}

/* --- Global Button Styling (+, -, Quit) --- */
QPushButton {
    background-color: transparent;
    color: white;
    border-radius: 20px;
    font-size: 40px;
    font-weight: bold;
    padding: 2px 10px; 
}

QPushButton:hover {
    background-color: #454545;
}

QPushButton:pressed {
    background-color: rgb(16, 146, 191);
}

/* --- Specific Button Overrides --- */
#panicQuitButton {
    background-color: #232424; 
    font-size: 18px;
    border: 1px solid #454545;
    border-radius: 15px;
}

#panicQuitButton:hover {
    background-color: #454545; 
}

#panicQuitButton:pressed {
    background-color: #232424
}

#panicButton, #resetPositionButton {
    background-color: #ff0000;
    font-size: 20px;
    padding: 8px;
    border-radius: 20px;
}

#panicButton:hover, #resetPositionButton:hover {
    background-color: #cc0000;
}

#panicButton:pressed, #resetPositionButton:pressed {
	background-color: rgb(128,0,0);
}

#HMDButton:disabled, #resetPositionButton:disabled {
	opacity: 05;
}</string>

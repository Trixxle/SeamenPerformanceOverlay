  <property name="styleSheet">
   <string notr="true">/* --- Main Window Background --- */
#MainFrame {
    background-color: #232424;
    border-radius: 40px;
    border: 2px solid rgb(16, 146, 191); 
}

/*--- Version Number ---*/
#versionNumber{
	font-size: 12px;
	font-weight: bold;
}

/* --- Top Blue Header --- */
#TitleFrame {
    background-color: rgb(16, 146, 191); 
    border-top-left-radius: 37px;
    border-top-right-radius: 37px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

#settingsTitle {
    font-size: 40px;
    font-weight: bold;
}

/* --- The Interaction Frame --- */
#InteractionFrame {
    border-radius: 30px;
}


/* --- The 4 Inner Grid Panels  Specific Styling--- */
#ScaleFrame, #OpacityFrame, #DistanceFadeFrame, #ResetFrame {
    background-color: rgb(50, 50, 50);
    border-radius: 30px;
}

#ScaleTitle, #OpacityTitle, #DistanceFadeTitle, #LostOrBrokeTitle {
	font-size: 25px;
    font-weight: bold;
}

#DistanceFadeTitleFrame, #ScaleTitleFrame, #OpacityTitleFrame, #LostOrBrokeTitleFrame {
    background-color: #454545;
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

#DistanceFadeInteractionFrame, #panicButtonFrame, #DistanceFadeCheckFrame{
	background-color: transparent;
	border: none;
}

/* --- Checkbox Container --- */
#distanceFadeCheck {
	font-size: 23px;
    spacing: 150px; /* Pushes the 'Enable' text away from the box */
    color: white;
}

/* --- The Unchecked State (Empty Circle) --- */
#distanceFadeCheck::indicator {
    width: 22px;
    height: 22px;
    border-radius: 11px; /* Setting radius to half the width makes a perfect circle */
    background-color: #232424; /* Matches your darkest background */
    border: 2px solid #454545; /* Subtle grey ring */
}

/* --- Hover State --- */
#distanceFadeCheck::indicator:hover {
    border: 2px solid rgb(16, 146, 191); /* Glows blue when hovered */
}

/* --- The Checked State (Filled Blue Circle) --- */
#distanceFadeCheck::indicator:checked {
    background-color: rgb(16, 146, 191); 
    border: 2px solid #232424;
    image: none; /* Prevents standard Qt checkmark from drawing over it */
}

/*--- Global QLabel --- */
QLabel {
	font-size: 23px;
}

/* --- Global Button Styling (+, -, Quit) --- */
QPushButton {
    background-color: transparent;
    color: white;
    border-radius: 28px;
    font-size: 40px;
    font-weight: bold;
    padding: 2px 10px; /* Adjust padding to fit your preferred height */
}

QPushButton:hover {
    background-color: #454545;
}

QPushButton:pressed {
    background-color: rgb(16, 146, 191);
}

/* --- Specific Button Overrides --- */
#panicQuitButton {
    background-color: #232424; /* Darker background for the quit button */
    font-size: 18px;
    border: 1px solid #454545;
    border-radius: 15px;
}

#panicQuitButton:hover {
    background-color: #454545; 
}

#panicQuitButton:pressed {
    background-color: #232424
}

#panicButton {
    background-color: #ff0000;
    font-size: 20px;
    padding: 8px;
    border-radius: 20px;
}

#panicButton:hover {
    background-color: #cc0000;
}

#panicButton:pressed{
	background-color: rgb(128,0,0);
}</string>

  <property name="styleSheet">
   <string notr="true">/* --- Main Window ---*/
#mainFrame{
	background-color: #232424; 
	border-radius: 60px; 
	border: 4px solid rgb(16, 146, 191); 
	margin: 4px; 
}

/*--- Bottom Tool Bar ---*/
#interactionFrame{
	background-color: rgb(50, 50, 50);
	border-top-left-radius: 0px;   
	border-top-right-radius: 0px;  
	border-bottom-left-radius: 55px; 
	border-bottom-right-radius: 55px;
}

/*--- Global Buttons ---*/
QPushButton {
	color: white;
	background-color: transparent;
	border: none;
}

QPushButton:hover {
	background-color: #262626;
}

QPushButton:pressed {
	background-color: #1EAEED;
	border-color: #1EAEED;
	color: black;
}

/*--- Specific Exit Button Styling ---*/
#exitButton{
	color: rgb(200,125,125);
}

/*--- Graph Statistics ---*/
#GPU, #CPU, #LiveFrameRate, #TotalFrameTime {
    background-color: rgb(50, 50, 50);
    border: none;
    border-top-left-radius: 0px;   
    border-top-right-radius: 0px;  
    border-bottom-left-radius: 45px; 
    border-bottom-right-radius: 45px;
}

/*--- Move Bar ---*/
#moveButton{
	background-color: rgb(125, 125, 125);
	border-radius: 8px;
}

#moveButton:pressed{
	background-color: rgb(255, 255, 255);
}

/*--- Move Bar Frame ---*/
#moveButtonFrame{
	background-color: transparent;
	border: none;
}</string>

  <property name="styleSheet">
   <string notr="true">/* --- Main Window ---*/
#mainFrame{
	background-color: #232424; 
	border-radius: 33px; 
	border: 2px solid rgb(16, 146, 191); 
}

/*--- Chart Views ---*/
#frameTimeConsistencyView, #cpuFrameTimeView,
#gpuFrameTimeView, #liveFrameRateView {
	background-color: rgb(255, 255, 255);
	border-top-left-radius: 22px;
	border-top-right-radius: 22px;
	border-bottom-left-radius: 0px;
	border-bottom-right-radius: 0px;
}

/*--- Global QLabel ---*/
QLabel{
	font-size: 22px;
}

/*--- Upper Option bar ---*/
#optionBar {
	background-color: rgb(50, 50, 50);
	border-top-left-radius: 27px;   
	border-top-right-radius: 27px;  
	border-bottom-left-radius: 0px; 
	border-bottom-right-radius: 0px;
}

#optionBar QLabel{
	font-size: 22px;
}

#optionBar QCheckBox {
	font-size: 22px;
    spacing: 10px; 
    color: white;
}

#optionBar QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border-radius: 8px; 
    background-color: #232424; 
    border: 1px solid #454545; 
}

#optionBar QCheckBox::indicator:hover {
    border: 1px solid rgb(16, 146, 191);
}

#optionBar QCheckBox::indicator:checked {
    background-color: rgb(16, 146, 191); 
    border: 1px solid #232424;
    image: none; 
}

#optionBar QPushButton {
	font-size: 25px;
}

#optionBar #switchControllerButton {
	font-size: 22px;
	border-top-right-radius: 27px;
}

/*--- Trackers Frame ---*/
#trackersFrame {
	background-color: transparent;
	border: none;
}

/*--- Bottom Information Bar ---*/
#interactionFrame{
	background-color: rgb(50, 50, 50);
	border-top-left-radius: 0px;   
	border-top-right-radius: 0px;  
	border-bottom-left-radius: 30px; 
	border-bottom-right-radius: 30px;
}

#interactionFrame QLabel {
	font-size: 22px;
}

#clock {
	font-weight: bold;
}

/*--- Global Buttons ---*/
QPushButton {
	font-size: 22px;
	color: white;
	background-color: transparent;
	border: none;
}

QPushButton:hover {
	background-color: #262626;
}

QPushButton:pressed {
	background-color: #1EAEED;
	border-color: #1EAEED;
	color: black;
}

/*--- Graph Statistics ---*/
#GPU, #CPU, #LiveFrameRate, #TotalFrameTime {
    background-color: rgb(50, 50, 50);
    border: none;
    border-top-left-radius: 0px;   
    border-top-right-radius: 0px;  
    border-bottom-left-radius: 22px; 
    border-bottom-right-radius: 22px;
}

/*--- Playtime Layout---*/
#playTimeTitle, #playtimeClock, #clock {
	padding-bottom: 2px;
}

/*--- Scale Bar ---*/
#scaleButton{
	font-size: 10px;
	background-color: rgb(125, 125, 125);
	border-radius: 10px;
}

#scaleButton:pressed{
	background-color: rgb(255, 255, 255);
}

/*--- Move Bar ---*/
#moveButton{
	font-size: 15px;
	background-color: rgb(125, 125, 125);
	border-radius: 10px;
}

#moveButton:pressed{
	background-color: rgb(255, 255, 255);
}

/*--- Move Bar and Scale Bar Frames ---*/
#moveButtonFrame, #scaleFrame{
	background-color: transparent;
	border: none;
}</string>
